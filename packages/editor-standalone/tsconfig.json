{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    // Ядро проверяется по исходникам, как и собирается: его dist/types на CI
    // ещё нет — typecheck идёт раньше сборки.
    "paths": {
      "@rich-editor/chemistry/viewer": ["../editor-chemistry/src/viewer.ts"],
      "@rich-editor/chemistry": ["../editor-chemistry/src/index.ts"],
      "@rich-editor/drawings/viewer": ["../editor-drawings/src/viewer.ts"],
      "@rich-editor/drawings": ["../editor-drawings/src/index.ts"],
      "@rich-editor/ocr": ["../editor-ocr/src/index.ts"],
      "@rich-editor/core/viewer": ["../editor-core/src/viewer.ts"],
      "@rich-editor/core/viewer.css": ["../editor-core/src/content.css"],
      "@rich-editor/core": ["../editor-core/src/index.ts"],
      "@rich-editor/core/styles.css": ["../editor-core/src/styles.css"]
    }
  },
  "include": ["src/**/*.ts"]
