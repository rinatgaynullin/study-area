{
  "name": "@rich-editor/standalone",
  "version": "0.1.0",
  "description": "Self-contained build of the rich editor for hosts without a bundler: ES modules with every dependency inside, plus styles and MathLive fonts",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./editor": "./dist/editor.js",
    "./viewer": "./dist/viewer.js",
    "./styles.css": "./dist/styles.css",
    "./legacy.css": "./dist/legacy.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@rich-editor/core": "*"
  }
}
