{
  "name": "@rich-editor/drawings",
  "version": "0.1.0",
  "description": "Geometry and physics drawings for @rich-editor/core: JSON scenes rendered to SVG, TikZ export, nodes, dialog and a light viewer entry",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/types/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:types && node scripts/check-dist.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rich-editor/core": "0.1.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
