{
  "name": "@rich-editor/ocr",
  "version": "0.1.0",
  "description": "PinQueen OCR text (Markdown + LaTeX + TikZ/JSON markers) to the editor document and back",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rich-editor/chemistry": "0.1.0",
    "@rich-editor/core": "0.1.0",
    "@rich-editor/drawings": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
